{
  "settings": {
    "analysis": {
      "char_filter": {
        "remove_line_breaks": {
          "type": "pattern_replace",
          "pattern": "\\r\\n|\\r|\\n",
          "replacement": " "
        }
      },
      "filter": {
        "english_stop": { "type": "stop", "stopwords": "_english_" },
        "english_possessive_stemmer": { "type": "stemmer", "language": "possessive_english" },
        "english_stemmer": { "type": "stemmer", "language": "english" }
      },
      "analyzer": {
        "screenjson_search": {
          "type": "custom",
          "char_filter": ["remove_line_breaks"],
          "tokenizer": "standard",
          "filter": ["lowercase", "asciifolding", "english_stop", "english_possessive_stemmer", "english_stemmer"]
        }
      }
    }
  },
  "mappings": {
    "dynamic": "strict",
    "properties": {
      "id": { "type": "keyword" },

      "screenplay_id": { "type": "keyword" },
      "scene_id": { "type": "keyword" },
      "line_ids": { "type": "keyword" },

      "lang": { "type": "keyword" },
      "text": { "type": "text", "analyzer": "screenjson_search" },

      "genre": { "type": "keyword" },
      "themes": { "type": "keyword" },
      "scene_tags": { "type": "keyword" },
      "scene_tone": { "type": "keyword" },
      "scene_beats": { "type": "keyword" },

      "model": { "type": "keyword" },
      "dims": { "type": "integer" },
      "created": { "type": "date" },

      "embedding": {
        "type": "dense_vector",
        "dims": 1536,
        "index": true,
        "similarity": "cosine"
      }
    }
  }
}
